# Core runtime
GIN_MODE=release
REDIS_ADDR=redis:6379

# Provider API keys (set at least one model provider key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Model enablement
ENABLED_MODELS=gpt-4o-mini,claude-3-5-haiku-latest,gemini-1.5-flash
ENABLED_IMAGE_MODELS=
ENABLED_SPEECH_MODELS=

# Optional tool APIs
NEWS_API_KEY=

# Platform/auth/runtime options
PLATFORM_SIGNING_SECRET=replace-with-strong-secret
HTTP_ENABLED=true
ASYNC_WORKERS_ENABLED=true
ASYNC_WORKERS=3
