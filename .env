GEMINI_2_5_FLASH_COST_OUTPUT="0"

GEMINI_2_5_FLASH_LITE_COST_INPUT="0"
GEMINI_2_5_FLASH_LITE_COST_OUTPUT="0"

GEMINI_2_5_PRO_COST_INPUT="0"
GEMINI_2_5_PRO_COST_OUTPUT="0"

MISTRAL_LARGE_3_COST_INPUT="0"
MISTRAL_LARGE_3_COST_OUTPUT="0"

GPT_4O_MINI_TTS_COST_INPUT="15.00"
GPT_4O_MINI_TTS_COST_OUTPUT="0.00"

TTS_1_HD_COST_INPUT="30.00"
TTS_1_HD_COST_OUTPUT="0.00"

GEMINI_2_5_FLASH_TTS_COST_INPUT="0"
GEMINI_2_5_FLASH_TTS_COST_OUTPUT="0"

GPT_IMAGE_1_5_COST_INPUT="0"
GPT_IMAGE_1_5_COST_OUTPUT="0"

IMAGEN_4_GENERATE_COST_INPUT="0"
IMAGEN_4_GENERATE_COST_OUTPUT="0"

GPT_4O_TRANSCRIBE_DIARIZE_COST_INPUT="0"
GPT_4O_TRANSCRIBE_DIARIZE_COST_OUTPUT="0"

VOXTRAL_MINI_TRANSCRIBE_REALTIME_COST_INPUT="0"
VOXTRAL_MINI_TRANSCRIBE_REALTIME_COST_OUTPUT="0"

OCR_3_PREMIER_COST_INPUT="0"
