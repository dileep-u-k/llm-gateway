# MODEL PRICING
# IMPORTANT:
# - Keep these aligned with your control-plane registry and provider billing
# - In production, prefer metadata sync over manual maintenance
# - Values below are placeholders/examples for local profiling
# ============================================================================
GPT_5_4_COST_INPUT="0"
GPT_5_4_COST_OUTPUT="0"

GPT_5_4_MINI_COST_INPUT="0"
GPT_5_4_MINI_COST_OUTPUT="0"

