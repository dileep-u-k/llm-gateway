# ============================================================================
# AUTONOMOUS AI ORCHESTRATION - ENVIRONMENT CONFIGURATION
# ============================================================================
#
# INSTRUCTIONS
# 1. Copy this file to ".env"
# 2. Fill in real values locally or through your deployment secret manager
# 3. NEVER commit ".env" to version control
# 4. Rotate any secrets that were previously exposed
#
# ============================================================================

# ============================================================================
# CORE APP / SERVER
# ============================================================================
APP_NAME="autonomous-ai-orchestration"
APP_ENV="production"
PORT="8081"
GIN_MODE="release"
LOG_LEVEL="info"
DEFAULT_TIMEZONE="UTC"

# ============================================================================
# CORE INFRASTRUCTURE
# ============================================================================
REDIS_ADDR="redis:6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Source data / ingestion
SOURCE_DATA_DIR="./data"
ARTIFACT_STORAGE_DIR="./artifacts"
TEMP_WORK_DIR="./tmp"

# ============================================================================
# OBJECT STORAGE / ARTIFACT STORAGE
# ============================================================================
# Use local in development, cloud object storage in production
ARTIFACT_STORAGE_BACKEND="local"   # local | gcs | s3
GCS_BUCKET_NAME=""
AWS_S3_BUCKET_NAME=""
AWS_REGION=""
SIGNED_URL_TTL="15m"

# ============================================================================
# VECTOR STORE / RAG
# ============================================================================
VECTOR_STORE_BACKEND="pinecone"    # pinecone | none
PINECONE_API_KEY=""
PINECONE_INDEX_HOST=""
PINECONE_INDEX_NAME="llm-gateway-rag"

# Embeddings / RAG controls
EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_API_URL="https://api.openai.com/v1/embeddings"
RAG_TOP_K="12"
RAG_RERANK_TOP_K="6"
RAG_MAX_CHUNKS="8"
RAG_MAX_CONTEXT_CHARS="16000"
RAG_FAILURE_POLICY="graceful_no_rag"   # graceful_no_rag | fail_if_grounded_required
EMBEDDING_CACHE_VERSION="v3"
RESPONSE_CACHE_VERSION="v3"
RAG_CORPUS_VERSION="phase6"

# ============================================================================
# API KEYS - LLM / MULTIMODAL PROVIDERS
# ============================================================================
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
MISTRAL_API_KEY=""

# Optional provider endpoint overrides
OPENAI_API_BASE="https://api.openai.com/v1"
ANTHROPIC_API_BASE="https://api.anthropic.com"
GEMINI_API_BASE="https://generativelanguage.googleapis.com"
MISTRAL_API_BASE="https://api.mistral.ai"

# ============================================================================
# OPTIONAL TOOL KEYS
# ============================================================================
NEWS_API_KEY=""
WEATHER_API_KEY=""
SEARCH_API_KEY=""

# ============================================================================
# ENABLED MODEL REGISTRY (TEXT / REASONING)
# ============================================================================
# These should match the IDs in your config.yaml model registry
ENABLED_MODELS="gpt-5.4,gpt-5.4-mini,gpt-4o,claude-sonnet-4-6,claude-opus-4-7,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro,mistral-large-3"

# ============================================================================
# ENABLED MULTIMODAL / SPECIALIST MODELS
# ============================================================================
ENABLED_IMAGE_MODELS="gpt-image-1.5,imagen-4-generate"
ENABLED_TRANSCRIPTION_MODELS="gpt-4o-transcribe-diarize,voxtral-mini-transcribe-realtime,gpt-realtime-1.5"
ENABLED_TTS_MODELS="gpt-4o-mini-tts,tts-1-hd,gemini-2.5-flash-tts"
ENABLED_OCR_MODELS="ocr-3-premier"
ENABLED_VIDEO_UNDERSTANDING_MODELS="gemini-2.5-pro,gemini-2.5-flash,gpt-4o"

# ============================================================================
# SESSION / FORCE SEMANTICS
# ============================================================================
SESSION_BACKEND="redis"
SESSION_TTL_HOURS="72"
ALLOW_MID_SESSION_FORCE_OVERRIDE="true"
DEFAULT_FORCE_SCOPE="primary_reasoner_force"   # primary_reasoner_force | capability_scoped_force | strict_end_to_end_force
STRICT_FORCE_DEFAULT="false"
ALLOW_AUXILIARY_STAGES_WHEN_PRIMARY_REASONER_FORCED="true"

# ============================================================================
# ROUTING / HEALTH / CIRCUIT BREAKERS
# ============================================================================
DEFAULT_ROUTE_POLICY="balanced"
ROUTE_EXPLANATION_ENABLED="true"
HEALTH_PROVIDER_PROBE_INTERVAL="60s"
HEALTH_MODEL_PROBE_INTERVAL="90s"
HEALTH_CAPABILITY_PROBE_INTERVAL="120s"
HEALTH_CHECK_STALENESS="5m"

MAX_ERROR_RATE="0.15"
MIN_REQUEST_COUNT_FOR_ERROR_CHECK="20"
CIRCUIT_BREAKER_FAILURE_THRESHOLD="3"
CIRCUIT_BREAKER_COOLDOWN="2m"

SMART_BALANCED_COST_THRESHOLD_USD="0.001"
ASYNC_DEFAULT_THRESHOLD_SECONDS="20"
VIDEO_ALWAYS_ASYNC_MINUTES="5"
AUDIO_ASYNC_DEFAULT_MINUTES="10"

# ============================================================================
# ASYNC RUNTIME / WORKERS
# ============================================================================
ASYNC_RUNTIME_ENABLED="true"
QUEUE_BACKEND="redis"      # redis | cloud_queue
JOB_RESULT_TTL_HOURS="168"
CHECKPOINTING_ENABLED="true"
MAX_STAGE_RETRIES="2"
DEAD_LETTER_ENABLED="true"

# Worker toggles
ENABLE_DOCUMENT_WORKERS="true"
ENABLE_OCR_WORKERS="true"
ENABLE_TRANSCRIPTION_WORKERS="true"
ENABLE_VISION_WORKERS="true"
ENABLE_GENERATION_WORKERS="true"
ENABLE_TTS_WORKERS="true"
ENABLE_EVAL_WORKERS="true"

# ============================================================================
# OBSERVABILITY / EVALUATION
# ============================================================================
METRICS_ENABLED="true"
TRACING_ENABLED="true"
STRUCTURED_LOGS_ENABLED="true"
AUDIT_LOG_ENABLED="true"
REQUEST_REPLAY_ENABLED="true"

ROUTING_EVAL_ENABLED="true"
RETRIEVAL_EVAL_ENABLED="true"
TOOL_EVAL_ENABLED="true"
MULTIMODAL_EVAL_ENABLED="true"
GENERATION_EVAL_ENABLED="true"
FAILOVER_EVAL_ENABLED="true"

# ============================================================================
# GOVERNANCE / SECURITY / TENANCY
# ============================================================================
POLICY_ENGINE_ENABLED="true"
MULTI_TENANCY_ENABLED="true"
TENANT_ISOLATION_REQUIRED="true"
RBAC_ENABLED="true"
SECRET_MANAGER_REQUIRED="false"   # set true in real production
ENCRYPT_ARTIFACT_METADATA="true"

# Optional secret manager integration
SECRET_MANAGER_BACKEND=""         # aws_secrets_manager | gcp_secret_manager | vault | ""
SECRET_MANAGER_PREFIX=""

# ============================================================================
# ACTIVE BUDGET TRACKING (USD / current month)
# ============================================================================
GPT_5_4_BUDGET_USD="300.00"
GPT_5_4_MINI_BUDGET_USD="150.00"
GPT_4O_BUDGET_USD="200.00"
CLAUDE_SONNET_4_6_BUDGET_USD="150.00"
CLAUDE_OPUS_4_7_BUDGET_USD="250.00"
GEMINI_2_5_FLASH_BUDGET_USD="120.00"
GEMINI_2_5_FLASH_LITE_BUDGET_USD="80.00"
GEMINI_2_5_PRO_BUDGET_USD="180.00"
MISTRAL_LARGE_3_BUDGET_USD="100.00"

GPT_IMAGE_1_5_BUDGET_USD="100.00"
IMAGEN_4_GENERATE_BUDGET_USD="100.00"

GPT_4O_TRANSCRIBE_DIARIZE_BUDGET_USD="75.00"
VOXTRAL_MINI_TRANSCRIBE_REALTIME_BUDGET_USD="50.00"

GPT_4O_MINI_TTS_BUDGET_USD="50.00"
TTS_1_HD_BUDGET_USD="50.00"
GEMINI_2_5_FLASH_TTS_BUDGET_USD="50.00"

OCR_3_PREMIER_BUDGET_USD="50.00"

